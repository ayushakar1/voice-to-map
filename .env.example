# Copy to .env and fill in. Without a key the app still runs: rule-based parser + browser speech recognition.
# Mistral key: used for Voxtral speech-to-text, and for intent unless LLM_* below is set
MISTRAL_API_KEY=
MISTRAL_STT_MODEL=voxtral-mini-latest

# Intent LLM on any OpenAI-compatible provider. Leave empty to use Mistral with MISTRAL_API_KEY.
# Featherless example:
# LLM_BASE_URL=https://api.featherless.ai/v1
# LLM_API_KEY=your-featherless-key
# LLM_MODEL=mistralai/Mistral-Small-24B-Instruct-2501
LLM_MODEL=mistral-small-latest
# Place names sent to the LLM (use 40 for 4k-context models like Mistral-7B)
LLM_NEARBY_NAMES=80
# Set to false if the provider rejects response_format (auto-detected on a 400 anyway)
LLM_JSON_MODE=true

# Area of operation: paris-marais | paris-latin | nyc-midtown, or a custom bbox "south,west,north,east"
AO_PRESET=paris-marais
# AO_BBOX=48.850,2.350,48.862,2.368

# Nominatim/Overpass usage policy asks for a real contact
HTTP_USER_AGENT=voice-to-map-edth-hackathon/0.1 (contact: your-email@example.com)

# Offline mode: use a prebuilt gazetteer file instead of Overpass
# GAZETTEER_FILE=test/fixtures/synthetic-gazetteer.json

# Spatial heuristics (metres)
OFFSET_DEFAULT_M=60
BEHIND_OFFSET_M=40
MOVE_STEP_M=150
ARRIVE_RADIUS_M=120
PORT=3000
