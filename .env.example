# Copy to .env and fill in. Without a key the app uses the rule parser and browser speech recognition.
# Featherless powers intent extraction. Browser speech recognition handles audio.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_LLM_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506

# Optional Mistral access for Voxtral speech-to-text and intent when Featherless is unset.
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-small-latest
MISTRAL_STT_MODEL=voxtral-mini-latest

# Area of operation: paris-marais | paris-latin | nyc-midtown, or a custom bbox "south,west,north,east"
AO_PRESET=paris-marais
# AO_BBOX=48.850,2.350,48.862,2.368

# Nominatim/Overpass usage policy asks for a real contact
HTTP_USER_AGENT=voice-to-map-edth-hackathon/0.1 (contact: your-email@example.com)

# Offline mode: use a prebuilt gazetteer file instead of Overpass
# GAZETTEER_FILE=test/fixtures/synthetic-gazetteer.json

# Spatial heuristics (metres)
OFFSET_DEFAULT_M=60
BEHIND_OFFSET_M=40
MOVE_STEP_M=150
ARRIVE_RADIUS_M=120
PORT=3000
